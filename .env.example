GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Required for Interactivity + Event Subscriptions (signing secret from Slack app settings)
SLACK_SIGNING_SECRET=

LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
# Optional 0–2; lower = more consistent triage (default 0.25 if unset)
LLM_CLASSIFY_TEMPERATURE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

PORT=3001

# Gmail push (users.watch + Pub/Sub)
# Example: projects/your-gcp-project/topics/gmail-inboxpilot
GMAIL_PUBSUB_TOPIC=
# Optional shared secret for /api/emails/watch/push?secret=...
GMAIL_PUSH_WEBHOOK_SECRET=
